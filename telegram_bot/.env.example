# Создайте бота через @BotFather и вставьте токен сюда.
TELEGRAM_BOT_TOKEN=1234567890:REPLACE_ME
TELEGRAM_BOT_USERNAME=YourFlexyWayBot

# Бот должен быть администратором этого канала для надёжной проверки getChatMember.
TELEGRAM_CHANNEL_ID=@your_flexy_way_channel
TELEGRAM_CHANNEL_URL=https://t.me/your_flexy_way_channel
SUBSCRIPTION_REQUIRED=true

PROMOCODES_XLSX=Flexy_Way_промокоды.xlsx
BOT_DATABASE=telegram_bot/data/flexy_way_bot.sqlite3
BOT_TIMEZONE=Europe/Moscow
TOKEN_TTL_HOURS=24
POLLING_TIMEOUT_SECONDS=30
MANAGER_MESSAGE=Менеджер свяжется с вами в ближайшее время!

# Безопасные значения по умолчанию: полные контакты не попадают в Excel,
# а зашифрованные данные автоматически очищаются через 30 дней.
BOT_DATA_SECRET=telegram_bot/data/local_secret.key
DATA_RETENTION_DAYS=30
EXCEL_PII_MODE=masked
ORGANIZER_NAME=Flexy Way
PRIVACY_CONTACT=@your_flexy_way_channel
RATE_LIMIT_PER_MINUTE=20
