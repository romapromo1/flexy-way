{
  "name": "flexy-way-gyro",
  "version": "1.0.0",
  "description": "3D game controlled with smartphone gyroscope like an air mouse / laser pointer",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test test/server.test.js",
    "relay:test": "npm --prefix relay test",
    "bot:init": "python -m telegram_bot init",
    "bot:run": "python -m telegram_bot run",
    "bot:test": "python -m unittest discover -s telegram_bot/tests -v"
  },
  "keywords": [
    "game",
    "threejs",
    "gyroscope",
    "webrtc",
    "air-mouse"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.1"
  }
}
